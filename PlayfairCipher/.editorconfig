# EditorConfig для PlayfairCipher
# https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cpp,h}]
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.txt]
charset = utf-8-bom

[*.md]
charset = utf-8
trim_trailing_whitespace = true

[*.{sln,vcxproj,vcxproj.filters}]
charset = utf-8-bom
indent_style = tab
